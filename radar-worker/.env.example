# Copy to .env for staging. Never commit a real token.
RADAR_CONTROL_PLANE_URL=https://sub2api.internal
RADAR_WORKER_TOKEN=replace-with-a-random-32-plus-character-staging-token
RADAR_REGION=staging
RADAR_ROUTE_PROFILE_VERSION=staging-v1
RADAR_EXECUTOR=openai
RADAR_EXECUTOR_URL=https://sub2api.internal
RADAR_INTERNAL_DOMAINS=sub2api.internal
RADAR_GRADER_IDS=exact,exact_json,protocol,safety,tool_call
RADAR_ANALYSIS_CAPABILITIES=aggregate_v1
RADAR_ANALYSIS_VERSION=v1
RADAR_SYNTHETIC_UPSTREAM_API_KEY=replace-with-a-dedicated-staging-only-key
